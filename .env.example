# Copy to .env and replace every value. .env is gitignored; never commit real tokens.
# Generate tokens with:  openssl rand -hex 32

# Admin API: full access (create and delete topics). Keep it off the website entirely.
LOGFORGE_ADMIN_TOKEN=replace-with-at-least-24-random-characters
# Admin API: read-only (what the website's route handler uses). Must differ from the admin token.
LOGFORGE_READ_TOKEN=replace-with-a-different-random-value
# Binary protocol: brokers, the controller and topic administration authenticate with it.
# Never give it to producers, consumers or the website.
LOGFORGE_CLUSTER_TOKEN=replace-with-a-third-random-value

# Exact origins allowed by CORS, comma-separated. No wildcard.
LOGFORGE_CORS_ORIGINS=http://localhost:3000

# fsync policy: never | records:N | ms:N
LOGFORGE_FSYNC=ms:1000

# --- Website (web/.env.local), server-side only ---
# LOGFORGE_ADMIN_URL=http://127.0.0.1:8080
# LOGFORGE_READ_TOKEN=same-read-token-as-above
