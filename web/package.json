{
  "name": "logforge-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "dev": "node scripts/sync-data.mjs && next dev",
    "build": "node scripts/sync-data.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/lookup.test.mjs scripts/brokerStatus.test.mjs"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.31"
    }
  },
  "dependencies": {
    "motion": "12.43.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
